# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication & JWT Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret
REFRESH_TOKEN_EXPIRY=10d

# Administrator Registration Passkey (for TPO Officer signups)
ADMIN_SECRET_KEY=TPO_ADMIN_2026

# Cloudinary CDN Configuration (for avatars, logos, resumes)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / SMTP Alerts (Optional: Simulated in console if omitted)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM="CampusFlow Notifications <your_email@gmail.com>"

# Frontend Application URL
FRONTEND_URL=http://localhost:5173
