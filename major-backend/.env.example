# ========================================================
# CampusFlow V2 Backend Environment Configuration (.env.example)
# ========================================================

# Server Configuration
# Render automatically injects PORT. For local dev, 8000 is used.
PORT=8000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Connection URI)
# In production, use your MongoDB Atlas SRV URI:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/Place-on?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/Place-on?retryWrites=true&w=majority

# Cross-Origin Resource Sharing (CORS)
# Production REQUIREMENT: Comma-separated list of exact HTTPS origins (no trailing slashes, no '*')
# e.g., https://campus-flow.vercel.app,https://yourcustomdomain.com
CORS_ORIGIN=https://your-frontend.vercel.app

# Authentication & JWT Secrets (Generate strong, random 256-bit strings)
ACCESS_TOKEN_SECRET=generate_strong_random_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=generate_strong_random_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=10d

# Administrator Registration Passkey (Required for TPO Admin account registration)
ADMIN_SECRET_KEY=choose_a_strong_secret_tpo_passkey_here

# Groq AI: student support assistant + TPO copilot (keep the key on the backend only)
# GROQ_MODEL is tried first; GROQ_FALLBACK_MODELS (comma-separated) are tried if it is unavailable.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODELS=llama-3.1-8b-instant

# Timezone used for dates in emails, reminders and AI answers
APP_TIMEZONE=Asia/Kolkata

# Cloudinary CDN Configuration (Optional: for resumes, job descriptions, student avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / SMTP Alerts (Optional: for placement alerts, interview reminders, offers)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM="CampusFlow TPO <your_email@gmail.com>"

# Frontend Application Origin (Optional redirect target)
FRONTEND_URL=https://your-frontend.vercel.app
